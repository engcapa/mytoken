# Server Configuration
PORT=3000

# Database Configuration
DATABASE_PATH=./data/shops.sqlite

# Scraping Configuration
TARGET_URL=https://wzyp.cn
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Optional: Custom Cookie for passing Cloud WAF verification
WAF_COOKIE=

# ============================================================
# TypeSafe Jev Model Service Configuration
# Official Endpoint: https://api.typesafe.ai/v1/systemone
# Jev is a high-speed "System One" decision model for structured judgments
# ============================================================
JEV_ENABLED=false
JEV_API_KEY=your_typesafe_jev_api_key_here
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_USE_PROXY=false

# ============================================================
# Proxy Configuration (HTTP/HTTPS)
# Example: http://127.0.0.1:7890
# ============================================================
GLOBAL_PROXY_ENABLED=false
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
